<UserControl
    x:Class="ConstructionAddIn.UserControls.Fittings.BallValve1Vent.BallValve1VentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ConstructionAddIn.UserControls.Fittings.BallValve1Vent"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="90"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <local:BallValve1VentViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Blue"
                    SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FittingButtonTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Margin="2"
        Padding="6"
        Background="#F1F8FF"
        BorderBrush="#1976D2"
        BorderThickness="1"
        CornerRadius="12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Draw button  -->
            <Button
                Grid.Column="0"
                Height="50"
                Margin="0,0,8,0"
                Padding="10,6"
                materialDesign:ButtonAssist.CornerRadius="10"
                Command="{Binding DrawCommand}"
                CommandParameter=""
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedButton}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Fitting symbol  -->
                    <StackPanel
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <!--  Ball  -->
                        <Canvas
                            Width="32"
                            Height="24"
                            Margin="0,0,6,0">

                            <Ellipse
                                Canvas.Left="5"
                                Canvas.Top="1"
                                Width="22"
                                Height="22"
                                Stroke="White"
                                StrokeThickness="3" />

                            <Line
                                Stroke="White"
                                StrokeThickness="3"
                                X1="8"
                                X2="24"
                                Y1="4"
                                Y2="20" />

                            <Line
                                Stroke="White"
                                StrokeThickness="3"
                                X1="24"
                                X2="8"
                                Y1="4"
                                Y2="20" />
                        </Canvas>

                        <!--  Valve  -->
                        <Canvas
                            Width="56"
                            Height="24"
                            Margin="0,0,6,0">

                            <Rectangle
                                Canvas.Left="0"
                                Canvas.Top="2"
                                Width="5"
                                Height="20"
                                Fill="White" />

                            <Polygon Fill="White" Points="14,2 28,12 14,22" />

                            <Polygon Fill="White" Points="42,2 28,12 42,22" />

                            <Rectangle
                                Canvas.Left="51"
                                Canvas.Top="2"
                                Width="5"
                                Height="20"
                                Fill="White" />
                        </Canvas>

                        <!--  Vent  -->
                        <Canvas Width="22" Height="26">

                            <Line
                                Stroke="White"
                                StrokeThickness="3"
                                X1="11"
                                X2="11"
                                Y1="0"
                                Y2="26" />

                            <Polygon Fill="White" Points="3,0 19,0 11,8" />

                            <Polygon Fill="White" Points="3,26 19,26 11,18" />
                        </Canvas>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource FittingButtonTextStyle}"
                        Text="Ball - Valve - (1) Vent" />
                </Grid>
            </Button>

            <!--  Delete button  -->
            <Button
                Grid.Column="1"
                Width="52"
                Height="50"
                Padding="0"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="#D32F2F"
                BorderBrush="#D32F2F"
                Command="{Binding DeleteCommand}"
                CommandParameter=""
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedButton}"
                ToolTip="Delete ball valve with one vent">

                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Kind="Delete" />
            </Button>
        </Grid>
    </Border>
</UserControl>