<UserControl
    x:Class="ConstructionAddIn.UserControls.Fittings.Reducer.ReducerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ConstructionAddIn.UserControls.Fittings.Reducer"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="90"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <local:ReducerViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Blue"
                    SecondaryColor="Lime" />

                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style
                x:Key="FittingButtonTextStyle"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Margin="2"
        Padding="6"
        Background="#F1F8FF"
        BorderBrush="#1976D2"
        BorderThickness="1"
        CornerRadius="12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Draw button -->
            <Button
                Grid.Column="0"
                Height="50"
                Margin="0,0,8,0"
                Padding="10,6"
                materialDesign:ButtonAssist.CornerRadius="10"
                Command="{Binding DrawCommand}"
                CommandParameter=""
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedButton}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Reducer symbol -->
                    <Canvas
                        Grid.Column="0"
                        Width="32"
                        Height="24"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">

                        <Polygon
                            Fill="White"
                            Points="16,2 3,22 29,22" />
                    </Canvas>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource FittingButtonTextStyle}"
                        Text="Reducer" />
                </Grid>
            </Button>

            <!-- Delete button -->
            <Button
                Grid.Column="1"
                Width="52"
                Height="50"
                Padding="0"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="#D32F2F"
                BorderBrush="#D32F2F"
                Command="{Binding DeleteCommand}"
                CommandParameter=""
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedButton}"
                ToolTip="Delete reducer">

                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Kind="Delete" />
            </Button>
        </Grid>
    </Border>
</UserControl>