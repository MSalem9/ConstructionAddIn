                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="Pipe" />
                                </ToggleButton>

                                <TextBlock
                                    Margin="10,0,8,0"
