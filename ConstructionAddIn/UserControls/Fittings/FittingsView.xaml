<UserControl x:Class="ConstructionAddIn.UserControls.Fittings.FittingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ConstructionAddIn.UserControls.Fittings"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Blue"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid  Margin="16,5,16,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Drawer PePipe -->
        <StackPanel Margin="0,0,0,0" Grid.Row="0">
            <TextBlock Text="Fittings"
                               Margin="0,5,0,8" 
                               FontSize="15"
                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="*"/>
                    
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <Button Content="Valve - Regulator" Grid.Row="0" Grid.Column="0"
                                Margin="6,6,3,6" Height="60"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding }" CommandParameter=""/>

                <Button Grid.Row="0" Grid.Column="1"
                                     Margin="3,6,6,6" Height="60"
                                     Command="{Binding }" CommandParameter=""
                                     Style="{StaticResource MaterialDesignRaisedButton}"
                                     Background="#D32F2F"
                                     Foreground="White"
                                     BorderBrush="#D32F2F">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" 
                                     Width="20" Height="20" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!-- Row 1 -->
                <Button Content="Valve - Pecat" Grid.Row="1" Grid.Column="0"
                                Margin="6,6,3,6" Height="60"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding }" CommandParameter=""/>

                <Button Grid.Row="1" Grid.Column="1"
                                     Margin="3,6,6,6" Height="60"
                                     Command="{Binding }" CommandParameter=""
                                     Style="{StaticResource MaterialDesignRaisedButton}"
                                     Background="#D32F2F"
                                     Foreground="White"
                                     BorderBrush="#D32F2F">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" 
                                     Width="20" Height="20" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!-- Row 2 -->
                <Button Content="Pecat - Valve - (1)Vent" Grid.Row="2" Grid.Column="0"
                Margin="6,6,3,6" Height="60"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Command="{Binding }" CommandParameter=""/>

                <Button Grid.Row="2" Grid.Column="1"
                     Margin="3,6,6,6" Height="60"
                     Command="{Binding }" CommandParameter=""
                     Style="{StaticResource MaterialDesignRaisedButton}"
                     Background="#D32F2F"
                     Foreground="White"
                     BorderBrush="#D32F2F">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" 
                     Width="20" Height="20" 
                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!-- Row 3 -->
                <Button Content="Ball - Valve - (1)Vent" Grid.Row="3" Grid.Column="0"
                Margin="6,6,3,6" Height="60"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Command="{Binding }" CommandParameter=""/>

                <Button Grid.Row="3" Grid.Column="1"
                     Margin="3,6,6,6" Height="60"
                     Command="{Binding }" CommandParameter=""
                     Style="{StaticResource MaterialDesignRaisedButton}"
                     Background="#D32F2F"
                     Foreground="White"
                     BorderBrush="#D32F2F">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" 
                     Width="20" Height="20" 
                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!-- Row 4 -->
                <Button Content="Pecat - Valve - (2)Vent" Grid.Row="4" Grid.Column="0"
                Margin="6,6,3,6" Height="60"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Command="{Binding }" CommandParameter=""/>

                <Button Grid.Row="4" Grid.Column="1"
                     Margin="3,6,6,6" Height="60"
                     Command="{Binding }" CommandParameter=""
                     Style="{StaticResource MaterialDesignRaisedButton}"
                     Background="#D32F2F"
                     Foreground="White"
                     BorderBrush="#D32F2F">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" 
                     Width="20" Height="20" 
                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!-- Row 5 -->
                <Button Content="Reducer" Grid.Row="5" Grid.Column="0"
                Margin="6,6,3,6" Height="60"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Command="{Binding }" CommandParameter=""/>

                <Button Grid.Row="5" Grid.Column="1"
                     Margin="3,6,6,6" Height="60"
                     Command="{Binding }" CommandParameter=""
                     Style="{StaticResource MaterialDesignRaisedButton}"
                     Background="#D32F2F"
                     Foreground="White"
                     BorderBrush="#D32F2F">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" 
                     Width="20" Height="20" 
                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>



            </Grid>
        </StackPanel>
    </Grid>
</UserControl>



