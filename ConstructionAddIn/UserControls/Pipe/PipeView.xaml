                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="#1A1A1A"
                                    Text="Pipe Drawing" />
                            </StackPanel>
                        </ToggleButton>
                    </TreeViewItem.Header>-->

            <Border
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10"
                Background="#F1F8FF"
                BorderBrush="#1976D2"
                BorderThickness="1"
                CornerRadius="12">

                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!--  Pipe Material  -->
                        <StackPanel Grid.Column="0" Margin="0,0,2.5,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="#1976D2"
                                    Kind="TextureBox" />

                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Style="{DynamicResource MaterialDesignHeadline6TextBlock}">

                                    <TextBlock.Inlines>
                                        <Run Text="Pipe Material" />
                                        <Run Foreground="Red" Text=" *" />
                                    </TextBlock.Inlines>
                                </TextBlock>
                            </StackPanel>

                            <ComboBox
                                Height="40"
                                Margin="0,8,0,0"
                                Padding="10,0,10,0"
                                materialDesign:HintAssist.Hint="Material"
                                materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                Background="White"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding PipeMaterialList}"
                                SelectedItem="{Binding SelectedPipeMaterial}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        </StackPanel>

                        <!--  Pipe Diameter  -->
                        <StackPanel Grid.Column="1" Margin="2.5,0,0,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="#1976D2"
                                    Kind="DiameterOutline" />

                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Style="{DynamicResource MaterialDesignHeadline6TextBlock}">

                                    <TextBlock.Inlines>
                                        <Run Text="Pipe Diameter" />
                                        <Run Foreground="Red" Text=" *" />
                                    </TextBlock.Inlines>
                                </TextBlock>
                            </StackPanel>

                            <ComboBox
                                Height="40"
                                Margin="0,8,0,0"
                                Padding="10,0,10,0"
                                materialDesign:HintAssist.Hint="Diameter"
                                materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                Background="White"
                                DisplayMemberPath="Name"
                                IsEnabled="{Binding IsPipeDiameterActive}"
                                ItemsSource="{Binding AvailablePipeDiameterList}"
                                SelectedItem="{Binding SelectedPipeDiameter}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        </StackPanel>

                        <!--  Pipe Description  -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,0">

                            <!--  Description header and boolean checkbox  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="#1976D2"
                                        Kind="TextBoxOutline" />

                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                        Text="Pipe Description" />
                                </StackPanel>

                                <CheckBox
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Content="Exist Line"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    IsChecked="{Binding IsPipeExistEnabled}"
                                    Style="{StaticResource MaterialDesignCheckBox}" />
                            </Grid>

                            <ComboBox
                                Height="40"
                                Margin="0,8,0,0"
                                Padding="10,0,10,0"
                                materialDesign:HintAssist.Hint="Description"
                                materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                Background="White"
                                IsEnabled="{Binding IsPipeDescriptionEnabled}"
                                ItemsSource="{Binding AvailablePipeDescriptionList}"
                                SelectedItem="{Binding SelectedPipeDescription}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        </StackPanel>
                    </Grid>

                    <!--  Action buttons  -->
                    <Grid Grid.Row="2" Margin="5,15,5,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Draw  -->
                        <Button
                            Grid.Column="0"
                            Height="40"
                            Margin="0,0,8,0"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Command="{Binding StartDrawing}"
                            CommandParameter="{Binding SelectedPipeDiameter.Code}"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}">

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,8,0"
                                    Kind="VectorLine" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="{Binding DrawButtonText}" />
                            </StackPanel>
                        </Button>

                        <!--  Delete  -->
                        <Button
                            Grid.Column="1"
                            Width="45"
                            Height="40"
                            Padding="0"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="#D32F2F"
                            BorderBrush="#D32F2F"
                            Command="{Binding DeleteLine}"
                            CommandParameter="{Binding DeleteCommandParameter}"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            ToolTip="{Binding DeleteButtonToolTip}">

                            <materialDesign:PackIcon
                                Width="22"
                                Height="22"
                                Foreground="White"
                                Kind="Delete" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <!--</TreeViewItem>
            </TreeView>-->
        </Grid>
    </ScrollViewer>
</UserControl>
