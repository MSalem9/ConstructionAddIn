<UserControl
    x:Class="ConstructionAddIn.UserControls.CrossingHotTap.CrossingHotTapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ConstructionAddIn.UserControls.CrossingHotTap"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="650"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Blue"
                    SecondaryColor="Lime" />

                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="5">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border
                Grid.Row="0"
                Margin="5,0,5,8"
                Padding="10,6"
                Background="#E61976D2"
                BorderBrush="#991976D2"
                BorderThickness="1"
                CornerRadius="12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Margin="0,0,8,0"
                        Background="#1565C0"
                        BorderBrush="#90CAF9"
                        BorderThickness="1"
                        CornerRadius="14">

                        <materialDesign:PackIcon
                            Width="17"
                            Height="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="PipeValve" />
                    </Border>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Crossing &amp; Hot Tap" />

                    <Button
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        materialDesign:RippleAssist.Feedback="#1565C0"
                        Background="White"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{Binding RefreshNames}"
                        Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                        ToolTip="Refresh project names">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Foreground="#1565C0"
                            Kind="Refresh" />
                    </Button>
                </Grid>
            </Border>

            <!-- Crossing and project information -->
            <TreeView
                Grid.Row="1"
                Margin="-50,0,-2,0"
                HorizontalAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <TreeViewItem
                    HorizontalContentAlignment="Stretch"
                    Background="White"
                    IsExpanded="True">

                    <TreeViewItem.Header>
                        <ToggleButton
                            Height="50"
                            Margin="15,0,0,0"
                            Padding="10,5"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="White"
                            IsChecked="{Binding IsExpanded,
                                                RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                            Style="{StaticResource MaterialDesignRaisedButton}">

                            <StackPanel Orientation="Horizontal">

                                <ToggleButton
                                    materialDesign:ElevationAssist.Elevation="Dp8"
                                    IsChecked="{Binding IsExpanded,
                                                        RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                    Style="{StaticResource MaterialDesignActionToggleButton}">

                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="FileDocument" />
                                </ToggleButton>

                                <TextBlock
                                    Margin="10,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="#1A1A1A"
                                    Text="Crossing Data" />
                            </StackPanel>
                        </ToggleButton>
                    </TreeViewItem.Header>

                    <Border
                        Padding="10"
                        Background="#F1F8FF"
                        BorderBrush="#1976D2"
                        BorderThickness="1"
                        CornerRadius="12">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Name -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="2,2,4,2">

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="#1976D2"
                                        Kind="FormTextbox" />

                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Style="{DynamicResource MaterialDesignHeadline6TextBlock}">

                                        <TextBlock.Inlines>
                                            <Run Text="Name" />
                                            <Run Foreground="Red" Text=" *" />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                </StackPanel>

                                <TextBox
                                    Height="40"
                                    Margin="0,8,0,0"
                                    Padding="10,0,10,0"
                                    materialDesign:HintAssist.Hint="Enter name"
                                    materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                    Background="White"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Name,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Pipe line name -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="4,2,2,2">

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="#1976D2"
                                        Kind="Pipe" />

                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Style="{DynamicResource MaterialDesignHeadline6TextBlock}">

                                        <TextBlock.Inlines>
                                            <Run Text="Pipe Line Name" />
                                            <Run Foreground="Red" Text=" *" />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                </StackPanel>

                                <TextBox
                                    Height="40"
                                    Margin="0,8,0,0"
                                    Padding="10,0,10,0"
                                    materialDesign:HintAssist.Hint="Enter pipe line name"
                                    materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                    Background="White"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding SelectedPipeLineName,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Project name -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="2,10,2,2">

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="#1976D2"
                                        Kind="OfficeBuilding" />

                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Style="{DynamicResource MaterialDesignHeadline6TextBlock}">

                                        <TextBlock.Inlines>
                                            <Run Text="Project Name" />
                                            <Run Foreground="Red" Text=" *" />
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                </StackPanel>

                                <ComboBox
                                    Height="40"
                                    Margin="0,8,0,0"
                                    Padding="10,0,10,0"
                                    materialDesign:HintAssist.Hint="Enter project name"
                                    materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                    Background="White"
                                    IsEditable="True"
                                    IsTextSearchEnabled="True"
                                    ItemsSource="{Binding ProjectsName}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    Text="{Binding SelectedProjectName,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </TreeViewItem>
            </TreeView>

            <!-- Drawing actions -->
            <TreeView
                Grid.Row="2"
                Margin="-50,0,-2,0"
                HorizontalAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <TreeViewItem
                    HorizontalContentAlignment="Stretch"
                    Background="White"
                    IsExpanded="True">

                    <TreeViewItem.Header>
                        <ToggleButton
                            Height="50"
                            Margin="15,0,0,0"
                            Padding="10,5"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="White"
                            IsChecked="{Binding IsExpanded,
                                                RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                            Style="{StaticResource MaterialDesignRaisedButton}">

                            <StackPanel Orientation="Horizontal">

                                <ToggleButton
                                    materialDesign:ElevationAssist.Elevation="Dp8"
                                    IsChecked="{Binding IsExpanded,
                                                        RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                    Style="{StaticResource MaterialDesignActionToggleButton}">

                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="VectorLine" />
                                </ToggleButton>

                                <TextBlock
                                    Margin="10,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="#1A1A1A"
                                    Text="Drawing Actions" />
                            </StackPanel>
                        </ToggleButton>
                    </TreeViewItem.Header>

                    <Border
                        Padding="10"
                        Background="#F1F8FF"
                        BorderBrush="#1976D2"
                        BorderThickness="1"
                        CornerRadius="12">

                        <TabControl
                            Margin="2"
                            SelectedIndex="{Binding SelectedTabIndex}">

                            <!-- Crossing tab -->
                            <TabItem Header="Crossing">

                                <Grid Margin="5,12,5,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Section information -->
                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="2,0,2,12"
                                        Orientation="Horizontal">

                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="#1976D2"
                                            Kind="TransitConnectionHorizontal" />

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                            Text="Draw or remove a crossing line" />
                                    </StackPanel>

                                    <!-- Crossing buttons -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Height="40"
                                            Margin="0,0,8,0"
                                            materialDesign:ButtonAssist.CornerRadius="10"
                                            Command="{Binding StartDrawing}"
                                            CommandParameter="Crossing"
                                            Foreground="White"
                                            Style="{StaticResource MaterialDesignRaisedButton}">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,8,0"
                                                    Kind="VectorLine" />

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Text="Draw Crossing" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Column="1"
                                            Width="45"
                                            Height="40"
                                            Padding="0"
                                            materialDesign:ButtonAssist.CornerRadius="10"
                                            Background="#D32F2F"
                                            BorderBrush="#D32F2F"
                                            Command="{Binding DeleteLine}"
                                            CommandParameter="CrossingNew"
                                            Foreground="White"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            ToolTip="Delete crossing">

                                            <materialDesign:PackIcon
                                                Width="22"
                                                Height="22"
                                                Foreground="White"
                                                Kind="Delete" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <!-- Hot tap tab -->
                            <TabItem Header="Hot Tap">

                                <Grid Margin="5,12,5,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Section information -->
                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="2,0,2,12"
                                        Orientation="Horizontal">

                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="#1976D2"
                                            Kind="PipeValve" />

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                            Text="Draw or remove a hot tap" />
                                    </StackPanel>

                                    <!-- Hot tap buttons -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Height="40"
                                            Margin="0,0,8,0"
                                            materialDesign:ButtonAssist.CornerRadius="10"
                                            Command="{Binding StartDrawing}"
                                            CommandParameter="HotTap"
                                            Foreground="White"
                                            Style="{StaticResource MaterialDesignRaisedButton}">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,8,0"
                                                    Kind="PipeValve" />

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Text="Draw Hot Tap" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Column="1"
                                            Width="45"
                                            Height="40"
                                            Padding="0"
                                            materialDesign:ButtonAssist.CornerRadius="10"
                                            Background="#D32F2F"
                                            BorderBrush="#D32F2F"
                                            Command="{Binding DeleteLine}"
                                            CommandParameter="HotTap"
                                            Foreground="White"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            ToolTip="Delete hot tap">

                                            <materialDesign:PackIcon
                                                Width="22"
                                                Height="22"
                                                Foreground="White"
                                                Kind="Delete" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </TreeViewItem>
            </TreeView>
        </Grid>
    </ScrollViewer>
</UserControl>