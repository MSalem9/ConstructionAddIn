<UserControl
    x:Class="ConstructionAddIn.UserControls.Fittings.Valve2VentsPecat.Valve2VentsPecatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ConstructionAddIn.UserControls.Fittings.Valve2VentsPecat"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="90"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <local:Valve2VentsPecatViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Blue"
                    SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FittingButtonTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Margin="2"
        Padding="6"
        Background="#F1F8FF"
        BorderBrush="#1976D2"
        BorderThickness="1"
        CornerRadius="12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Draw button  -->
            <Button
                Grid.Column="0"
                Height="50"
                Margin="0,0,8,0"
                Padding="10,6"
                materialDesign:ButtonAssist.CornerRadius="10"
                Command="{Binding DrawCommand}"
                CommandParameter=""
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedButton}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Smaller fitting symbol  -->
                        <StackPanel
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <!--  Pecat  -->
                            <Canvas
                                Width="28"
                                Height="24"
                                Margin="0,0,6,0">

                                <Ellipse
                                    Canvas.Left="3"
                                    Canvas.Top="1"
                                    Width="22"
                                    Height="22"
                                    Fill="White"
                                    Stroke="White"
                                    StrokeThickness="1.5" />

                                <TextBlock
                                    Canvas.Left="10"
                                    Canvas.Top="3"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="#1976D2"
                                    Text="P" />
                            </Canvas>

                            <!--  Valve  -->
                            <Canvas
                                Width="54"
                                Height="24"
                                Margin="0,0,6,0">

                                <Rectangle
                                    Canvas.Left="0"
                                    Canvas.Top="2"
                                    Width="4"
                                    Height="20"
                                    Fill="White" />

                                <Polygon Fill="White" Points="13,2 27,12 13,22" />

                                <Polygon Fill="White" Points="41,2 27,12 41,22" />

                                <Rectangle
                                    Canvas.Left="50"
                                    Canvas.Top="2"
                                    Width="4"
                                    Height="20"
                                    Fill="White" />
                            </Canvas>

                            <!--  Two vents  -->
                            <StackPanel Orientation="Horizontal">

                                <Canvas
                                    Width="18"
                                    Height="26"
                                    Margin="0,0,2,0">

                                    <Line
                                        Stroke="White"
                                        StrokeThickness="3"
                                        X1="9"
                                        X2="9"
                                        Y1="0"
                                        Y2="26" />

                                    <Polygon Fill="White" Points="2,0 16,0 9,7" />

                                    <Polygon Fill="White" Points="2,26 16,26 9,19" />
                                </Canvas>

                                <Canvas Width="18" Height="26">

                                    <Line
                                        Stroke="White"
                                        StrokeThickness="3"
                                        X1="9"
                                        X2="9"
                                        Y1="0"
                                        Y2="26" />

                                    <Polygon Fill="White" Points="2,0 16,0 9,7" />

                                    <Polygon Fill="White" Points="2,26 16,26 9,19" />
                                </Canvas>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource FittingButtonTextStyle}"
                        Text="Pecat - Valve - (2) Vent" />
                </Grid>
            </Button>

            <!--  Delete button  -->
            <Button
                Grid.Column="1"
                Width="52"
                Height="50"
                Padding="0"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="#D32F2F"
                BorderBrush="#D32F2F"
                Command="{Binding DeleteCommand}"
                CommandParameter=""
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedButton}"
                ToolTip="Delete Pecat valve with two vents">

                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Kind="Delete" />
            </Button>
        </Grid>
    </Border>
</UserControl>