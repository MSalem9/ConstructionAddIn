<UserControl x:Class="ConstructionAddIn.UserControls.Pipe.PipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ConstructionAddIn.UserControls.Pipe" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Blue"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    

    <Grid  Margin="16,5,16,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Line Name"
                       FontSize="15"
                       Style="{DynamicResource MaterialDesignHeadline6TextBlock}" />
            <TextBox Margin="0,8,0,0"
                     Padding="10,0,10,0"
                     Height="40"
                     materialDesign:HintAssist.Hint="Enter line name"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SelectedPipeLineName}"/>    
        </StackPanel>-->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="1"
               Margin="0,2,0,0"
               Text="Line Name"
               FontSize="15"
               Style="{DynamicResource MaterialDesignHeadline6TextBlock}" />

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Margin="0,0,5,0"
                     Padding="10,0,10,0"
                     Grid.Column="0"
                     Height="40"
                     materialDesign:HintAssist.Hint="Enter line name"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SelectedPipeLineName}"/>

                <TextBox Margin="5,0,0,0"
                     Padding="10,0,10,0"
                     Grid.Column="1"
                     Height="40"
                     materialDesign:HintAssist.Hint="Details ''optional''"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding OptionalDetails}"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
               Margin="0,5,0,0"
               Text="Project Name"
               FontSize="15"
               Style="{DynamicResource MaterialDesignHeadline6TextBlock}" />

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          Height="40"
                          Padding="10,0,10,0"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          materialDesign:HintAssist.Hint="Enter name"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Text="{Binding SelectedProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding ProjectsName}" />

                <Button Grid.Column="1"
                Width="40"
                Height="40"
                Margin="8,0,0,0"
                Padding="0"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Command="{Binding RefreshNames}"
                ToolTip="Refresh">

                    <materialDesign:PackIcon Kind="Refresh"
                                     Width="20"
                                     Height="20"/>
                </Button>
            </Grid>
        </Grid>

        <TabControl Grid.Row="3" Margin="0,5,0,0" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="PePipe">
                <!-- Drawer PePipe -->
                <StackPanel Margin="0,0,0,0">
                    <TextBlock 
                               Margin="0,-5,0,8" 
                               FontSize="15"
                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0 -->
                        <Button Content="32  mm" Grid.Row="0" Grid.Column="0"
                                Margin="6,6,3,6" Height="30"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="32"/>

                        <Button Content="63  mm" Grid.Row="0" Grid.Column="1"
                                Margin="3,6,6,6" Height="30"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="63"/>

                        <!-- Row 1 -->
                        <Button Content="90  mm" Grid.Row="1" Grid.Column="0"
                                Margin="6,6,3,6" Height="30"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="90"/>

                        <Button Content="125 mm" Grid.Row="1" Grid.Column="1"
                                Margin="3,6,6,6" Height="30"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="125"/>

                        <!-- Row 2 -->
                        <Button Content="180 mm" Grid.Row="2" Grid.Column="0"
                                Margin="6,6,3,6" Height="30"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="180"/>

                        <Button Content="250 mm" Grid.Row="2" Grid.Column="1"
                                Margin="3,6,6,6" Height="30"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="250"/>

                        <!-- Row 3 -->
                        <Button Content="315 mm" Grid.Row="3" Grid.Column="0"
                                Margin="6,6,3,6" Height="30" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="315"/>

                        <Button Content="355 mm" Grid.Row="3" Grid.Column="1"
                                Margin="3,6,6,6" Height="30" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="355"/>

                        <!-- Row 2 (Delete button spans all columns) -->
                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                                Margin="6"
                                Height="30"
                                Content="Delete PePipe"
                                Command="{Binding DeleteLine}"
                                CommandParameter="PePipes"
                                FontSize="17"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#D32F2F"
                                Foreground="White"
                                BorderBrush="#D32F2F"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem Header="SteelPipe">
                <!-- Drawer SteelPipe -->
                <StackPanel Margin="0,0,0,0">
                    <TextBlock 
                               Margin="0,-5,0,8" 
                               FontSize="15"
                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0 -->
                        <Button Content="3''" Grid.Row="0" Grid.Column="0"
                                Margin="6,6,3,6" Height="30" Padding="0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="3"/>

                        <Button Content="6''" Grid.Row="0" Grid.Column="1"
                                Margin="3,6,6,6" Height="30" Padding="0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="6"/>

                        <!-- Row 1 -->
                        <Button Content="8''" Grid.Row="1" Grid.Column="0"
                                Margin="6,6,3,6" Height="30" Padding="0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="8"/>

                        <Button Content="10''" Grid.Row="1" Grid.Column="1"
                                Margin="3,6,6,6" Height="30" Padding="0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="10"/>
                        
                        <!-- Row 2 -->
                        <Button Content="12''" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                Margin="6" Height="30" Padding="0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StartDrawing}" CommandParameter="12"/>


                        <!-- Row 3 (Delete button spans all columns) -->
                        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                                Margin="0,6,0,6"
                                Height="30"
                                Content="Delete Steel Pipe"
                                Command="{Binding DeleteLine}" 
                                CommandParameter="Steel"
                                FontSize="17"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#D32F2F"
                                Foreground="White"
                                BorderBrush="#D32F2F"/>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
