<UserControl
    x:Class="ConstructionAddIn.UserControls.Fittings.ValveRegulator.ValveRegulatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ConstructionAddIn.UserControls.Fittings.ValveRegulator"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="90"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <local:ValveRegulatorViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Blue"
                    SecondaryColor="Lime" />

                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style
                x:Key="FittingButtonTextStyle"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Margin="2"
        Padding="6"
        Background="#F1F8FF"
        BorderBrush="#1976D2"
        BorderThickness="1"
        CornerRadius="12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Draw button -->
            <Button
                Grid.Column="0"
                Height="50"
                Margin="0,0,8,0"
                Padding="10,6"
                materialDesign:ButtonAssist.CornerRadius="10"
                Command="{Binding DrawCommand}"
                CommandParameter=""
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedButton}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Smaller fitting symbol -->
                    <StackPanel
    Grid.Column="0"
    Margin="0,0,10,0"
    VerticalAlignment="Center"
    Orientation="Horizontal">

                        <!-- Valve -->
                        <Canvas
        Width="54"
        Height="24"
        Margin="0,0,6,0">

                            <Rectangle
            Width="4"
            Height="20"
            Canvas.Left="0"
            Canvas.Top="2"
            Fill="White" />

                            <Polygon
            Fill="White"
            Points="13,2 27,12 13,22" />

                            <Polygon
            Fill="White"
            Points="41,2 27,12 41,22" />

                            <Rectangle
            Width="4"
            Height="20"
            Canvas.Left="50"
            Canvas.Top="2"
            Fill="White" />
                        </Canvas>

                        <!-- Regulator -->
                        <Canvas
        Width="30"
        Height="24">

                            <Ellipse
            Width="22"
            Height="22"
            Canvas.Left="4"
            Canvas.Top="1"
            Stroke="White"
            StrokeThickness="3" />

                            <Line
            X1="8"
            X2="22"
            Y1="5"
            Y2="19"
            Stroke="White"
            StrokeThickness="3" />

                            <Line
            X1="22"
            X2="8"
            Y1="5"
            Y2="19"
            Stroke="White"
            StrokeThickness="3" />
                        </Canvas>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource FittingButtonTextStyle}"
                        Text="Valve - Regulator" />
                </Grid>
            </Button>

            <!-- Delete button -->
            <Button
                Grid.Column="1"
                Width="52"
                Height="50"
                Padding="0"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="#D32F2F"
                BorderBrush="#D32F2F"
                Command="{Binding DeleteCommand}"
                CommandParameter=""
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedButton}"
                ToolTip="Delete valve regulator">

                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Kind="Delete" />
            </Button>
        </Grid>
    </Border>
</UserControl>