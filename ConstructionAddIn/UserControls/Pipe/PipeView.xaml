<UserControl
    x:Class="ConstructionAddIn.UserControls.Pipe.PipeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ConstructionAddIn.UserControls.Pipe"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="650"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Blue"
                    SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="10,6"
                Background="#E61976D2"
                BorderBrush="#991976D2"
                BorderThickness="1"
                CornerRadius="12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Pipe Icon  -->
                    <Border
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Margin="0,0,8,0"
                        Background="#1565C0"
                        BorderBrush="#90CAF9"
                        BorderThickness="1"
                        CornerRadius="14">

                        <materialDesign:PackIcon
                            Width="17"
                            Height="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="Pipe" />
                    </Border>

                    <!--  Title  -->
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Pipe" />

                    <!--  Convert To Exist  -->
                    <Button
                        Grid.Column="2"
                        Width="auto"
                        Height="30"
                        Margin="0,0,10,0"
                        Padding="8,0"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        materialDesign:RippleAssist.Feedback="#1565C0"
                        Background="White"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{Binding ConvertToExist}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        ToolTip="Convert selected pipe to Exist">

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="#1565C0"
                                Kind="TransferRight" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1565C0"
                                Text="Convert to Exist" />

                        </StackPanel>
                    </Button>

                    <!--  Refresh  -->
                    <Button
                        Grid.Column="3"
                        Width="28"
                        Height="28"
                        Padding="0"
                        materialDesign:RippleAssist.Feedback="#1565C0"
                        Background="White"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{Binding RefreshNames}"
                        Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                        ToolTip="Refresh project names">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Foreground="#1565C0"
                            Kind="Refresh" />
                    </Button>

                </Grid>
            </Border>

            <!--  Pipe Data  -->
            <!--<TreeView
                Grid.Row="1"
                Margin="-50,0,-2,0"
                HorizontalAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">-->

            <!--<TreeViewItem
                    HorizontalContentAlignment="Stretch"
                    Background="White"
                    IsExpanded="True">-->

