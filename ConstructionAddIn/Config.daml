<ArcGIS defaultAssembly="ConstructionAddIn.dll" defaultNamespace="ConstructionAddIn" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{2f37d5e1-298a-4cc7-8dd6-f5e12f70bb2b}" version="1.0" desktopVersion="3.4.55405" product="ArcGISPro">
    <Name>ConstructionAddIn</Name>
    <Description>ConstructionAddIn description</Description>
    <Image>Images\AddinDesktop32.png</Image>
    <Author>Mahmoud.Salem.51275</Author>
    <Company>Acme</Company>
    <Date>5/11/2026 12:15:15 PM</Date>
    <Subject>Framework</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>
  <modules>
    <insertModule id="ConstructionAddIn_Module" className="Module1" autoLoad="false" caption="Module1">
      <!-- uncomment to have the control hosted on a separate tab-->
      <tabs>
        <!--<tab id="ConstructionAddIn_Tab1" caption="New Tab">
          <group refID="ConstructionAddIn_Group1"/>
        </tab>-->
      </tabs>
      <groups>
        <!-- comment this out if you have no controls on the Addin tab to avoid
              an empty group-->
        <group id="ConstructionAddIn_Group1" caption="Group 1" appearsOnAddInTab="true">
          <!-- host controls within groups -->
          <button refID="ConstructionAddIn_Dockpanes_MainDockpane_Construction_ShowButton" size="large" />
          <tool refID="ConstructionAddIn_Tools_RemovingTools_RemoveLineTool" size="large" />
          <tool refID="ConstructionAddIn_Tools_AddingTools_CreateLineTool" size="large" />
          <tool refID="ConstructionAddIn_Tools_AddingTools_CreateCrossingTool" size="large" />
        </group>
      </groups>
      <controls>
        <!-- add your controls here -->
        <button id="ConstructionAddIn_Dockpanes_MainDockpane_Construction_ShowButton" caption="Show Construction" className="ConstructionAddIn.Dockpanes.MainDockpane.Construction_ShowButton" loadOnClick="true" smallImage="GenericButtonPurple16" largeImage="GenericButtonPurple32">
          <tooltip heading="Show Dockpane">Show Dockpane<disabledText /></tooltip>
        </button>
        <tool id="ConstructionAddIn_Tools_RemovingTools_RemoveLineTool" caption="RemoveLineTool" className="ConstructionAddIn.Tools.RemovingTools.RemoveLineTool" loadOnClick="true" smallImage="GenericButtonRed16" largeImage="GenericButtonRed32" condition="esri_mapping_mapPane">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </tool>
        <tool id="ConstructionAddIn_Tools_AddingTools_CreateLineTool" caption="CreateLineTool" className="ConstructionAddIn.Tools.AddingTools.CreateLineTool" loadOnClick="true" smallImage="GenericButtonRed16" largeImage="GenericButtonRed32" condition="esri_mapping_mapPane">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </tool>
        <tool id="ConstructionAddIn_Tools_AddingTools_CreateCrossingTool" caption="CreateCrossingTool" className="ConstructionAddIn.Tools.AddingTools.CreateCrossingTool" loadOnClick="true" smallImage="GenericButtonRed16" largeImage="GenericButtonRed32" condition="esri_mapping_mapPane">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </tool>
      </controls>
      <dockPanes>
        <dockPane id="ConstructionAddIn_Dockpanes_MainDockpane_Construction" caption="Construction" className="ConstructionAddIn.Dockpanes.MainDockpane.ConstructionViewModel" dock="group" dockWith="esri_core_projectDockPane">
          <content className="ConstructionAddIn.Dockpanes.MainDockpane.ConstructionView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>