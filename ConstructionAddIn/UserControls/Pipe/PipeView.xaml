                                    FontWeight="Bold"
                                    Foreground="#1A1A1A"
                                    Text="Pipe Data" />
                            </StackPanel>
                        </ToggleButton>
                    </TreeViewItem.Header>-->

            <Border
                Grid.Row="1"
                Padding="10"
                Background="#F1F8FF"
                BorderBrush="#1976D2"
                BorderThickness="1"
                CornerRadius="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Line Name  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="#1976D2"
                                Kind="FormTextbox" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                Text="Line Name" />
                        </StackPanel>

                        <TextBox
                            Height="40"
                            Margin="0,8,0,0"
                            Padding="10,0,10,0"
                            materialDesign:HintAssist.Hint="Enter line name"
                            materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                            Background="White"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedPipeLineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!--  Optional Details  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="#1976D2"
                                Kind="TextBoxOutline" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                Text="Optional Comments" />
                        </StackPanel>

                        <TextBox
                            Height="40"
                            Margin="0,8,0,0"
                            Padding="10,0,10,0"
                            materialDesign:HintAssist.Hint="Optional Comments"
                            materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                            Background="White"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding OptionalComments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!--  Project Name  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="2,10,2,2">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="#1976D2"
                                Kind="OfficeBuilding" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                Text="Project Name" />
                        </StackPanel>

                        <ComboBox
                            Height="40"
                            Margin="0,8,0,0"
                            Padding="10,0,10,0"
                            materialDesign:HintAssist.Hint="Enter project name"
                            materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                            Background="White"
                            IsEditable="True"
                            IsTextSearchEnabled="True"
                            ItemsSource="{Binding ProjectsName}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="{Binding SelectedProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </Border>
            <!--</TreeViewItem>
            </TreeView>-->

