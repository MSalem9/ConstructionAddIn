<UserControl
    x:Class="ConstructionAddIn.UserControls.Fittings.FittingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ballValve1Vent="clr-namespace:ConstructionAddIn.UserControls.Fittings.BallValve1Vent"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ConstructionAddIn.UserControls.Fittings"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reducer="clr-namespace:ConstructionAddIn.UserControls.Fittings.Reducer"
    xmlns:valve1VentPecat="clr-namespace:ConstructionAddIn.UserControls.Fittings.Valve1VentPecat"
    xmlns:valve2VentsPecat="clr-namespace:ConstructionAddIn.UserControls.Fittings.Valve2VentsPecat"
    xmlns:valvePecat="clr-namespace:ConstructionAddIn.UserControls.Fittings.ValvePecat"
    xmlns:valveRegulator="clr-namespace:ConstructionAddIn.UserControls.Fittings.ValveRegulator"
    d:DesignHeight="650"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Blue"
                    SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <local:FittingsViewModel x:Key="Vm" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Entire user control scrolls  -->
    <ScrollViewer
        CanContentScroll="False"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <Grid Margin="5" DataContext="{StaticResource Vm}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Margin="5,0,5,8"
                Padding="10,6"
                Background="#E61976D2"
                BorderBrush="#991976D2"
                BorderThickness="1"
                CornerRadius="12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Header icon  -->
                    <Border
                        Grid.Column="0"
                        Width="34"
                        Height="34"
                        Margin="0,0,8,0"
                        Background="#1565C0"
                        BorderBrush="#90CAF9"
                        BorderThickness="1"
                        CornerRadius="17">

                        <materialDesign:PackIcon
                            Width="17"
                            Height="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="PipeValve" />
                    </Border>

                    <!--  Header title  -->
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Fittings" />

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                    <!--  Flip selected box  -->
                    <Border
                        Grid.Column="2"
                        Padding="12,1,1,1"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#BBDEFB"
                        BorderThickness="1"
                        CornerRadius="17">

                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#1565C0"
                                Text="Flip Selected" />

                            <Button
                                Width="34"
                                Height="34"
                                Padding="0"
                                materialDesign:RippleAssist.Feedback="#90CAF9"
                                Background="#1565C0"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding FlipSelectedCommand}"
                                Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                                ToolTip="Flip selected fitting">

                                <materialDesign:PackIcon
                                    Width="19"
                                    Height="19"
                                    Foreground="White"
                                    Kind="SwapHorizontal" />
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!--  Section content  -->
            <Border
                Grid.Row="1"
                Margin="5,0,5,5"
                Padding="10"
                Background="#F1F8FF"
                BorderBrush="#1976D2"
                BorderThickness="1"
                CornerRadius="12">

                <ScrollViewer
                    CanContentScroll="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Fittings list  -->
                        <valveRegulator:ValveRegulatorView Grid.Row="0" Margin="0,0,0,5" />

                        <valvePecat:ValvePecatView Grid.Row="1" Margin="0,0,0,5" />

                        <valve1VentPecat:Valve1VentPecatView Grid.Row="2" Margin="0,0,0,5" />

                        <ballValve1Vent:BallValve1VentView Grid.Row="3" Margin="0,0,0,5" />

                        <valve2VentsPecat:Valve2VentsPecatView Grid.Row="4" Margin="0,0,0,5" />

                        <reducer:ReducerView Grid.Row="5" Margin="0,0,0,0" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>